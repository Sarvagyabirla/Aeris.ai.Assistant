# Aeris Configuration — Copy this to .env and fill in your values.
# NEVER commit the actual .env file.

# --- Required ---
# Your Google Gemini API key (get one at https://aistudio.google.com)
AERIS_API_KEY=

# --- AI Model ---
AERIS_MODEL=gemini-2.0-flash

# --- Application ---
AERIS_APP_NAME=Aeris
AERIS_LOG_LEVEL=INFO

# --- Safety Controls ---
# Set to True to run in simulation mode: Aeris will describe actions but not perform them.
AERIS_DRY_RUN=False

# Kill switch starts enabled by default (False = kill switch starts OFF = normal operation).
AERIS_KILL_SWITCH=False

# --- Filesystem Security ---
# Comma-separated list of directories Aeris is allowed to read/write.
# Defaults to your home directory if not set.
# Example: AERIS_ALLOWED_PATHS=C:\Users\YourName\Documents,C:\Projects
AERIS_ALLOWED_PATHS=

# --- Shell Command Security ---
# Comma-separated allowlist of shell commands Aeris may execute.
# Commands NOT in this list will be rejected even if confirmed.
AERIS_COMMAND_ALLOWLIST=ping,echo,dir,ls

# --- Timeouts ---
# Maximum seconds for a single tool action before it times out.
AERIS_ACTION_TIMEOUT=10
